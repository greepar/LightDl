<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>LightDl</PackageId>
    <Version>0.4.6</Version>
    <Authors>LightDl Contributors</Authors>
    <Description>A lightweight multi-threaded HTTP downloader for .NET with resume support.</Description>
    <PackageTags>download;http;multipart;resume;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/greepar/LightDl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/greepar/LightDl.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>$(Features);runtime-async=on</Features>
    <UseRuntimeAsync>true</UseRuntimeAsync>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="buildTransitive/**/*;native-licenses/**/*" />
    <None Include="buildTransitive/**/*" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="native-licenses/**/*" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="BuildQuicPatcher" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../../eng/PatchQuic/PatchQuic.csproj" Targets="Restore;Build"
             Properties="Configuration=Release" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;PublishAot;SelfContained" />
    <ItemGroup>
      <None Include="../../eng/PatchQuic/bin/Release/net10.0/*.dll;../../eng/PatchQuic/bin/Release/net10.0/*.json"
            Pack="true" PackagePath="tools/" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="../../eng/STATIC-QUIC.md" Pack="true" PackagePath="eng/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
