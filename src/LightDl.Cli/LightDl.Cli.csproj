<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.6</Version>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightDl\LightDl.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LightDlStaticQuic)' == 'true'">
    <LightDlQuicPatcherPath>$(MSBuildThisFileDirectory)../../eng/PatchQuic/bin/Release/net10.0/PatchQuic.dll</LightDlQuicPatcherPath>
  </PropertyGroup>
  <Target Name="BuildSourceQuicPatcher" BeforeTargets="LightDlPatchQuicRuntime" Condition="'$(LightDlStaticQuic)' == 'true'">
    <MSBuild Projects="../../eng/PatchQuic/PatchQuic.csproj" Targets="Restore;Build"
             Properties="Configuration=Release" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;PublishAot;SelfContained;RuntimeFrameworkVersion" />
  </Target>
  <Import Project="../LightDl/buildTransitive/LightDl.targets" />
</Project>
