<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <LightDlQuicPatcherPath>$(MSBuildThisFileDirectory)../PatchQuic/bin/Release/net10.0/PatchQuic.dll</LightDlQuicPatcherPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LightDl/LightDl.csproj" />
  </ItemGroup>
  <Target Name="BuildSourceQuicPatcher" BeforeTargets="LightDlPatchQuicRuntime" Condition="'$(LightDlStaticQuic)' == 'true'">
    <MSBuild Projects="../PatchQuic/PatchQuic.csproj" Targets="Restore;Build"
             Properties="Configuration=Release" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;PublishAot;SelfContained;RuntimeFrameworkVersion" />
  </Target>
  <Import Project="../../src/LightDl/buildTransitive/LightDl.targets" />
</Project>
