<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <LightDlStaticQuic>true</LightDlStaticQuic>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual package and its transitive targets, not a project reference. -->
    <PackageReference Include="LightDl" Version="$(LightDlTestPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="StuDev.AotAnywhere" Version="1.1.0" />
    <PackageReference Include="Vezel.Zig.Toolsets.$(NETCoreSdkPortableRuntimeIdentifier)" Version="0.17.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
