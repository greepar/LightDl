<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LightDlSmokeTargetFramework Condition="'$(LightDlSmokeTargetFramework)' == ''">net10.0</LightDlSmokeTargetFramework>
    <TargetFramework>$(LightDlSmokeTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <LightDlStaticQuic>true</LightDlStaticQuic>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual package and its transitive targets, not a project reference. -->
    <PackageReference Include="LightDl" Version="$(LightDlTestPackageVersion)" />
  </ItemGroup>
</Project>
